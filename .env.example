# Copiá este archivo a `.env` y ajustá los valores. NO committear `.env` (está en .gitignore).

# === Stack docker-compose.prod.yml (Portainer) ===
# En Portainer: New stack -> pegar el compose -> pegar este contenido en
#   Environment variables (modo avanzado), o definir las vars una a una.
IMAGE=sos-reclamos-nicegui:latest
# Clave para firmar sesiones de NiceGUI. Generá una nueva: openssl rand -hex 32
STORAGE_SECRET=14bfd7937c3f2accdf32b76a1cd153f5c0743a35a4a93bab98439496f3b0bf24
POSTGRES_USER=sos
# Password de Postgres. Generá una nueva: openssl rand -hex 16
POSTGRES_PASSWORD=ee56e1a021c9a02ef05804ca976898db
POSTGRES_DB=sos_reclamos
# Puerto expuesto en el host (el contenedor siempre escucha en 8081).
UI_PORT=8081

# === Base de datos destino (flujo local, sin compose; en el stack el compose arma DATABASE_URL) ===
# Postgres local (docker compose up -d) o sqlite dev (sqlite:///sos.db)
DATABASE_URL=postgresql+psycopg://sos:sos@localhost:5432/sos_reclamos

# === Servidor UI (NiceGUI, flujo local) ===
UI_HOST=127.0.0.1

# === Import histórico (scripts/import_old_db.py) ===
# Origen: base SQLite legada + carpeta files/docs al lado.
OLD_DB_PATH=/ruta/a/gestiones.db
# "1" escribe de verdad; cualquier otro valor (o ausente) = dry run
IMPORT_APPLY=1
# Límite de gestiones a importar (opcional, útil para pruebas)
# IMPORT_LIMIT=

# === Primer usuario (scripts/bootstrap.py) ===
BOOTSTRAP_USER=admin
BOOTSTRAP_PASSWORD=minimo-8-caracteres
# BOOTSTRAP_ROLE=admin