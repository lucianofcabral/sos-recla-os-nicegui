# Copiá este archivo a `.env` y ajustá los valores.
# Las variables ya seteadas en el entorno (export) tienen prioridad.
# La construcción completa (import + bootstrap + app) lee solo de acá.

# === Base de datos destino ===
# Postgres local (docker compose) o sqlite dev (sqlite:///sos.db)
DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/sos_reclamos

# === Servidor UI (NiceGUI) ===
UI_HOST=127.0.0.1
UI_PORT=8080
# Clave secreta de sesión; en producción usá un valor aleatorio.
# STORAGE_SECRET=

# === Import histórico (scripts/import_old_db.py) ===
# Origen: base SQLite legada
OLD_DB_PATH=/ruta/a/gestiones.db
# "1" escribe de verdad; cualquier otro valor (o ausente) = dry run
IMPORT_APPLY=1
# Límite de gestiones a importar (opcional, útil para pruebas)
# IMPORT_LIMIT=

# === Primer usuario (scripts/bootstrap.py) ===
BOOTSTRAP_USER=admin
BOOTSTRAP_PASSWORD=minimo-8-caracteres
# BOOTSTRAP_ROLE=admin