{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "ruff": {
      "command": [".venv/bin/ruff", "server"],
      "extensions": [".py"]
    }
  },
  "provider": {
    "ollama": {
      "options": {
        "baseURL": "http://localhost:11434/v1"
      }
    }
  },
  "agent": {
    "general": {
      "mode": "subagent",
      "model": "opencode-go/mimo-v2.5"
    },
    "general-pro": {
      "mode": "subagent",
      "model": "opencode-go/mimo-v2.5"
    }
  }
}
